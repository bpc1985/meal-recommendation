# Copy this file to <repo>/.env. `apps/web/vite.config.ts` loads the root .env into
# process.env for dev/test (ADR-009); production must supply these from the runtime.
# Shell variables win over values in the file.

# Absolute path to the SQLite database. Defaults to <repo>/data/mam.db
# DATABASE_PATH=/absolute/path/to/data/mam.db

# Default locale for the MCP server: vi | en
MAM_LOCALE=vi

# Set to "production" when deploying over HTTPS (secure session cookie)
NODE_ENV=development

# AI provider: mock (offline, deterministic) | gemini (Google Gemini API)
AI_PROVIDER=mock

# Required when AI_PROVIDER=gemini. Server refuses to start without it.
# GEMINI_API_KEY=...

# Optional. Defaults to gemini-3.5-flash (deprecated by Google, which routes it to gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.5-flash
